[Unit]
Description=NetGuard AI — FastAPI + Uvicorn Backend
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/netguard-ai
EnvironmentFile=/home/ubuntu/netguard-ai/.env
ExecStart=/home/ubuntu/netguard-ai/.venv/bin/uvicorn backend.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
